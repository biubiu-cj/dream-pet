# ============================================================
# DreamPet 环境变量模板
# 复制为 .env 或直接在启动环境中配置；.env 已被 .gitignore 忽略。
# 切勿把真实 API Key / 数据库密码提交到 Git。
# ============================================================

# ---------- AI 大模型（仅真实模式，只使用文本模型，不涉及图片/语音模型）----------
# 必填：DeepSeek / 智谱 / Moonshot 等任意 OpenAI 兼容服务的 Key
# 未配置时 AI 接口返回 503，并给出明确提示
LLM_API_KEY=
# OpenAI 兼容 API 地址（示例：DeepSeek https://api.deepseek.com/v1）
LLM_BASE_URL=https://api.deepseek.com/v1
# 模型名称（按供应商文档填写，例如 deepseek-chat）
LLM_MODEL=deepseek-chat
# 读超时（毫秒）：云托管单请求时限较短，默认 30s，超时会自动重试 1 次
LLM_READ_TIMEOUT_MS=30000
# 单次回复最大 token（控制成本与延迟）
LLM_MAX_TOKENS=600

# ---------- 认证 ----------
# Token 签名密钥，生产环境必须填写 32 位以上随机字符串（留空会被启动自检拒绝）
# 生成示例：python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=

# ---------- 服务 ----------
# 后端端口（云托管可注入）
PORT=8080
# 运行环境：local（H2 文件库）/ prod（PostgreSQL）
# 本地开发不设置也行（application.yml 默认 local）。
# 部署时请设为 prod；镜像本身已默认 prod，切勿在部署用的 env 文件里写 local，否则会覆盖镜像默认值并退回 H2。
# SPRING_PROFILES_ACTIVE=local

# ---------- 演示体验优化 ----------
# 距上次聊天超过该分钟数后，进入聊天页会基于真实记忆生成「欢迎回来」
# 演示时可设为 0 立即触发（默认 30）
GREETING_IDLE_MINUTES=30
# 意图识别：规则优先，无法判断时是否调用一次短 LLM 请求兜底
# 生产默认 false（省调用），本地可按需开启
INTENT_LLM_ENABLED=true

# ---------- AI 调用限流（内存计数，单实例有效，防止公网刷调用）----------
CHAT_RATE_LIMIT=40
TASK_RATE_LIMIT=12
INTENT_RATE_LIMIT=60

# ---------- 前端构建（Vite，构建时注入）----------
# 静态托管与云托管不同域时，必须指向后端域名，例如 https://your-service.example.com/api
# 本地开发保持 /api（Vite proxy 转发到 8080）
VITE_API_BASE=/api

# ---------- CORS ----------
# 生产环境填写前端静态托管域名，多个用逗号分隔；本地可用 *
# 示例：https://your-env-id.web.app,https://your-domain.com
CORS_ALLOWED_ORIGINS=*

# ---------- 生产数据库：CloudBase PostgreSQL（仅 prod 需要）----------
# 在 CloudBase 控制台「PostgreSQL → 直连服务」获取内网地址/端口/库名/账号密码
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# 可选连接参数，例如 ?sslmode=require（按 CloudBase 直连要求填写，留空即可）
DB_PARAMS=
# 生产首次部署可临时设为 always 让程序自动建表（脚本幂等），建表完成后建议改回 never
DB_INIT_MODE=never